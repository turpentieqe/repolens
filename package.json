{
  "name": "repolens-local",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first interactive dependency map for JavaScript and TypeScript projects.",
  "type": "module",
  "bin": {
    "repolens": "dist/server/cli.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx src/server/cli.ts --demo --dev",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node dist/server/cli.js",
    "demo": "node dist/server/cli.js --demo",
    "check": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:ui": "npm run build && playwright test"
  },
  "dependencies": {
    "d3-force": "^3.0.1",
    "ignore": "^7.0.14",
    "lucide-react": "^1.69.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~6.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "tsx": "^4.23.15",
    "vite": "^8.3.6"
  }
}
